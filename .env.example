# Copy to .env, fill privately, then run npm run env:prepare.
# This writes a gitignored .dev.vars for local Wrangler. Never prefix secrets VITE_.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
PLAN_YEAR=2026

# Set true only after service scope, consent, and retention configuration are verified.
PATIENT_PROCESSING_APPROVED=false
AI_PROCESSING_APPROVED=false
AI_RETENTION_VERIFIED=false
# Application signing secret (not a patient token). Generate at least 32 random characters.
SESSION_SIGNING_KEY=

# Server registrations live in config/connectors.json (server-only, no secret values).
# Add a record there to add a connection; no code changes or automatic registration.
# Set each record's clientIdEnv/clientSecretEnv bindings privately in this file.
# Example for a record using HOSPITAL_123_CLIENT_ID / HOSPITAL_123_CLIENT_SECRET:
# HOSPITAL_123_CLIENT_ID=
# HOSPITAL_123_CLIENT_SECRET=
# Optional small JSON-array override replaces the entire bundled registry; omit when unused.
# CONNECTOR_REGISTRY='[{"id":"hospital-123","name":"Example Hospital","kind":"provider","scopeProfile":"smart","fhirBaseUrl":"https://ehr.example.com/fhir","clientIdEnv":"HOSPITAL_123_CLIENT_ID"}]'
# Large registries must use config/connectors.json; Worker variables have size/count limits.
# Register SMART authorization-code clients with S256 PKCE; no offline access.
# Exact callback for each authorization server: <APP_ORIGIN>/oauth/callback/<registry-id>
# Bundled defaults retain /oauth/callback/atrius and /oauth/callback/cigna.
# EPIC_* names are also supported when the corresponding ATRIUS_* key is absent.
ATRIUS_CLIENT_ID=
ATRIUS_CLIENT_SECRET=
# Default: client_secret_basic when a secret exists, otherwise none (public client).
# ATRIUS_TOKEN_AUTH_METHOD=client_secret_basic
# Optional exact registered callback; Atrius also supports <APP_ORIGIN>/auth/callback.
ATRIUS_REDIRECT_URI=
ATRIUS_FHIR_BASE_URL=https://iatrius.atriushealth.org/FHIR/api/FHIR/R4
# Optional overrides; otherwise read .well-known/smart-configuration from the FHIR server.
ATRIUS_AUTHORIZATION_URL=
ATRIUS_TOKEN_URL=
ATRIUS_SCOPES=launch/patient patient/*.read
ATRIUS_RESPONSE_MODE=query

# Use the Patient Access endpoint approved for your registration and plan.
# v1-devportal is a sandbox; a public directory URL is not a patient endpoint.
CIGNA_CLIENT_ID=
CIGNA_CLIENT_SECRET=
# Default: client_secret_post when a secret exists, otherwise none (public PKCE client).
# CIGNA_TOKEN_AUTH_METHOD=client_secret_post
CIGNA_REDIRECT_URI=
CIGNA_FHIR_BASE_URL=
CIGNA_AUTHORIZATION_URL=
CIGNA_TOKEN_URL=
# Identity scopes are accepted; imports still require a patient in the token response.
CIGNA_SCOPES=openid fhirUser patient/*.read
CIGNA_RESPONSE_MODE=query

# OpenAI Responses adapter. Use a project/model approved for the required data handling.
# store:false is set in code; it does NOT by itself establish Zero Data Retention.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Public canonical catalog acquisition (no patient data).
# catalog:fetch downloads and validates canonical public-reference JSON; it does not publish.
# The short-term provider must supply this format; other provider formats need an adapter.
# Use the final public HTTPS URL without query parameters; redirects are rejected.
SHORT_TERM_FEED_URL=
# Optional bearer credential, sent only to the configured endpoint.
SHORT_TERM_FEED_TOKEN=

# Deployment credentials are consumed only by local/CI tooling, never the browser bundle.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKER_NAME=plan-shepherd
# true binds APP_ORIGIN's hostname as a Cloudflare custom domain; otherwise uses workers.dev.
CLOUDFLARE_CUSTOM_DOMAIN=false
CATALOG_DATABASE_ID=
PRODUCTION_READINESS_FILE=
