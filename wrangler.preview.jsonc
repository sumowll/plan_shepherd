{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "plan-shepherd-preview",
  "account_id": "ab48bbf30b3343b679131327ae3c793f",
  "main": "./dist/plan_shepherd/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "plan-shepherd-preview.moonbacare.com", "custom_domain": true }],
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": false, "logs": { "enabled": false }, "traces": { "enabled": false } },
  "logpush": false,
  "ratelimits": [{ "name": "API_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }],
  "vars": {
    "APP_ENV": "production",
    "APP_ORIGIN": "https://plan-shepherd-preview.moonbacare.com",
    "PLAN_YEAR": "2026",
    // "ATRIUS_CLIENT_ID":,
    // "BCH_CLIENT_ID":,
    "EPIC_CLIENT_ID": "582e1153-7cb5-417f-8979-05a5e9beddc8",
    "CIGNA_CLIENT_ID": "93927d8b-32b4-4c28-bb78-2002e8239da2",
    "AETNA_CLIENT_ID": "aetna-moonbacare",
    "PATIENT_PROCESSING_APPROVED": "false",
    "AI_PROCESSING_APPROVED": "false",
    "AI_RETENTION_VERIFIED": "false",
    "PRODUCTION_RELEASE_APPROVED": "false",
    "PRODUCTION_CATALOG_RELEASE_ID": ""
  }
}
