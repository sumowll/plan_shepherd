{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "plan-shepherd-dev",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist/client", "not_found_handling": "single-page-application", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": false, "logs": { "enabled": false }, "traces": { "enabled": false } },
  "ratelimits": [{ "name": "API_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "d1_databases": [{ "binding": "CATALOG", "database_name": "plan-shepherd-catalog", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "vars": { "APP_ENV": "development", "PLAN_YEAR": "2026", "PATIENT_PROCESSING_APPROVED": "false", "AI_PROCESSING_APPROVED": "false" }
}
