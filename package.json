{
  "name": "plan-shepherd",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "node --import tsx scripts/build.ts",
    "typecheck": "npm run cf:types && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "WRANGLER_LOG_PATH=.cache/wrangler WRANGLER_SEND_METRICS=false wrangler dev --port 8787",
    "cf:types": "WRANGLER_LOG_PATH=.cache/wrangler WRANGLER_SEND_METRICS=false wrangler types --config wrangler.jsonc --include-runtime false --strict-vars false",
    "deploy:check": "node --import tsx scripts/deploy.ts --target preview --dry-run",
    "deploy": "node --import tsx scripts/deploy.ts",
    "deploy:preview": "node --import tsx scripts/deploy.ts --target preview",
    "deploy:preview:check": "node --import tsx scripts/deploy.ts --target preview --dry-run",
    "deploy:preview:upload": "node --import tsx scripts/deploy.ts --target preview --upload-only",
    "verify:production": "node --import tsx scripts/verify-production.ts",
    "catalog:import": "node --import tsx scripts/import-catalog.ts",
    "catalog:fetch": "node --import tsx scripts/fetch-catalog.ts",
    "db:migrate:local": "WRANGLER_LOG_PATH=.cache/wrangler WRANGLER_SEND_METRICS=false wrangler d1 migrations apply plan-shepherd-catalog --local",
    "env:prepare": "node --import tsx scripts/prepare-env.ts",
    "connectors:check": "node --import tsx scripts/check-connectors.ts",
    "deploy:production:check": "node --import tsx scripts/deploy.ts --dry-run",
    "db:migrate:production": "node --import tsx scripts/migrate-production.ts",
    "readiness:template": "node --import tsx scripts/readiness-template.ts"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@cloudflare/workers-types": "latest",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "jsdom": "^30.0.1",
    "jsonc-parser": "^3.3.1",
    "node": "^24.0.0",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "^8.0.0",
    "vitest": "latest",
    "wrangler": "^4.0.0"
  }
}
