{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "@cloudflare/workers-types", "vite/client"]
  },
  "include": ["src", "scripts", "tests", "worker-configuration.d.ts", "vite.config.ts", "vitest.config.ts"]
}
